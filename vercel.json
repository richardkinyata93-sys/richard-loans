{
  "rewrites": [
    {
      "source": "/",
      "destination": "/vercel/index.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/vercel/assets/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
